{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "integrations/python/Dockerfile",
    "watchPatterns": ["integrations/python/**", "example/recipe-app/python/**", "api/schema/**", "railway.python-handler.json"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
